# Enter this value in the dashboard at runtime. It is not a Vite build variable
# and must never be compiled into browser assets.
HASURA_GRAPHQL_ADMIN_SECRET=replace-with-a-long-random-secret

# --- sync (make sync / make backfill) ---

# Postgres the sync writes to. Local stack:
#   postgres://postgres:postgres@localhost:5432/local
# Cloud: take the connection string from the Nhost dashboard.
DATABASE_URL=

# Garmin credentials are only needed for the FIRST run, to create the token
# cache. Afterwards garth refreshes silently and these can be removed.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where the garth OAuth tokens are cached between runs.
GARTH_DIR=~/.garmin-sync/garth

# Seconds between Garmin requests. Raise it if a backfill starts getting
# rate-limited; the backfill is resumable, so a slow run is fine.
REQUEST_DELAY_S=2.0
