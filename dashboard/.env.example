# MapTiler API key for the 3D terrain route view (domain-restrict it in the
# MapTiler dashboard, since it ships to the browser).
VITE_MAPTILER_KEY=

# Stadia Maps key for the 2D route basemaps. Optional on localhost, which Stadia
# serves unauthenticated; every other origin gets 401 error tiles unless the
# domain is allowlisted on the Stadia account or this key is set.
VITE_STADIA_API_KEY=

VITE_HASURA_GRAPHQL_ENDPOINT=https://local.hasura.local.nhost.run/v1/graphql
VITE_NHOST_AUTH_URL=https://local.auth.local.nhost.run/v1
